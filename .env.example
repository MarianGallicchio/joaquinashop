# ───────────────────────────────────────────────────────────────
# La Joaquina · configuración de entorno
# Copiá este archivo como .env y completá las claves reales.
# Si dejás una pasarela vacía, esa pasarela funciona en MODO DEMO.
# ───────────────────────────────────────────────────────────────

PORT=4173
BASE_URL=http://localhost:4173

# Seguridad
ADMIN_PASSWORD=lajoaquina2026
SESSION_SECRET=cambiame-por-un-string-largo-y-aleatorio
# auto = demo en desarrollo y apagado en producción. true/false para forzar.
# En producción usar false.
DEMO_MODE=auto

# Negocio
STORE_NAME=La Joaquina
STORE_EMAIL=hola@lajoaquina.shop
WHATSAPP=5491126730077
FREE_SHIPPING_THRESHOLD=80000
ARS_PER_USD=1250

# MercadoPago (Checkout Pro)
MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=
MP_WEBHOOK_SECRET=

# Stripe (Checkout Sessions)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# PayPal (Orders API v2)
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_MODE=sandbox

# Cripto (NOWPayments)
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=

# Transferencia bancaria (Argentina)
BANK_HOLDER=Daiana Gallicchio
BANK_NAME=Mercado Pago
BANK_CBU=
BANK_ALIAS=joaquina.shop.mp
BANK_CUIT=

# Cripto manual (USDT TRC20) cuando no hay NOWPayments
USDT_TRC20_ADDRESS=TXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ───────────────────────────────────────────────────────────────
# Dropshipping real (CJ Dropshipping · API v2)
# ───────────────────────────────────────────────────────────────
# demo | cj | manual. Vacío = cj si hay CJ_API_KEY, si no demo.
SUPPLIER_PROVIDER=
# true = paga el pedido en CJ desde tu saldo (payType=2). false = lo pagás en CJ.
SUPPLIER_AUTO_PAY=false
# Cada cuántos minutos se sincroniza el tracking de pedidos abiertos.
SUPPLIER_SYNC_MINUTES=15
SUPPLIER_MAX_ATTEMPTS=8

# Credenciales: CJ → Developers → API Keys.
CJ_API_KEY=
# openId de tu cuenta CJ. Es el secreto del webhook (CJ lo devuelve al autenticar).
CJ_OPEN_ID=
# Opcional: secreto propio para verificar el header sign (si no, se usa openId).
CJ_WEBHOOK_SECRET=
CJ_BASE_URL=https://developers.cjdropshipping.com/api2.0/v1
# true = pedidos sandbox (no cobra ni genera logística real). Pasar a false para vender.
CJ_SANDBOX=true
CJ_LOGISTIC_NAME=CJPacket Ordinary
CJ_FROM_COUNTRY_CODE=CN
# Mapeo de tus SKU locales al SKU/VID de CJ.
# Un SKU por producto: {"massage-gun":"CJ..."}
# O un SKU por variante/color: {"massage-gun::Negro":"CJ...","massage-gun::Verde":"CJ..."}
CJ_SKU_MAP={}

# Email transaccional (Resend). Sin clave, los emails se registran en el log.
RESEND_API_KEY=
EMAIL_FROM=La Joaquina <pedidos@lajoaquina.shop>

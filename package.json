{
  "name": "la-joaquina-store",
  "version": "1.0.0",
  "private": true,
  "description": "La Joaquina — tienda de hogar y deco con checkout multipasarela y automatización de pedidos",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "seed": "node scripts/seed.js --force",
    "check": "npm run check:demo && npm run check:supplier && npm run check:browser",
    "check:demo": "node scripts/smoke.js",
    "check:supplier": "node scripts/supplier-smoke.js",
    "check:browser": "node scripts/browser-smoke.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "express": "^5.3.0"
  },
  "devDependencies": {
    "playwright-core": "^1.65.0"
  }
}
